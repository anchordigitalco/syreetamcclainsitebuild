# ---------------------------------------------------------------------------
# Contact form — Formspree + Cloudflare Turnstile
#
# Both values below are PUBLIC by design and ship in the browser bundle. That
# is correct for this build and is not a leak:
#   - the Formspree endpoint is a public POST target; abuse is what Turnstile
#     and the honeypot are for
#   - a Turnstile SITEKEY is public by specification
#
# The Turnstile SECRET key is NOT in this file and must never enter this repo.
# Formspree stores it in its own dashboard and verifies the token server-side.
# There is no server in this project to hold it — the site is fully static.
# ---------------------------------------------------------------------------

# Formspree form endpoint. Dashboard -> your form -> Integration -> AJAX.
# Format: https://formspree.io/f/<form_id>
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# Cloudflare Turnstile sitekey.
# The value below is Cloudflare's OFFICIAL always-passes TEST sitekey and is
# safe to commit. Replace with the live sitekey at launch.
#   1x00000000000000000000AA  always passes
#   2x00000000000000000000AB  always fails
#   3x00000000000000000000FF  forces the interactive challenge
# A test sitekey emits a dummy token that only the matching TEST secret
# validates. Never pair a test sitekey with the live secret in the Formspree
# dashboard, or every submission fails verification.
PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
