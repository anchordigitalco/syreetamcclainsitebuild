---
// 4. PILLAR — Premier Leadership, LLC. Asymmetric, photo bleeds LEFT.
---

<section class="pillar" id="sec-pillar">
  <figure class="pillar-figure relative m-0 isolate">
    <img
      class="block w-full h-full object-cover"
      src="/brand_assets/KNOW%20shoot%205.jpg"
      alt="Dr. Syreeta McClain seated in a leopard-print blazer against a warm tan ground"
    />
  </figure>
  <div class="pillar-copy flex flex-col justify-center">
    <p class="pillar-kicker">Premier Leadership, LLC</p>
    <p class="pillar-role">Founder &amp; CEO | Educational Consultant</p>
    <p class="pillar-lede">&ldquo;Leadership is not simply a position&mdash;it is the responsibility to move people, ideas, and organizations forward.&rdquo;</p>
    <div class="pillar-body">
      <p>Premier Leadership was created from more than 20 years of real-world experience leading schools, developing programs, navigating complex systems, and working alongside students, families, educators, and community partners. Dr.&nbsp;McClain brings that experience beyond the schoolhouse to help others turn vision into meaningful action.</p>
      <p>Through consulting, leadership coaching, professional development, workshops, strategic planning, program development, and speaking engagements, Premier Leadership partners with schools, organizations, leaders, and communities ready to strengthen their people and increase their impact.</p>
    </div>
    <a class="pillar-link self-start" href="https://www.premierleadersllc.com" target="_blank" rel="noopener">Visit Premier Leadership</a>
  </div>
</section>

<style>
  .pillar{
    margin-top: clamp(128px, 19vw, 264px);
    display: grid;
    grid-template-columns: minmax(0, 44fr) minmax(0, 56fr);
    align-items: stretch;
    overflow: hidden;
  }

  .pillar-figure{
    min-height: 86svh;
    background: var(--obsidian);
  }

  .pillar-figure img{
    object-position: 56% 20%;   /* focal point: her face */
    filter: grayscale(0.14) contrast(1.03);
  }

  .pillar-figure::before{
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(196deg, var(--porcelain) 0%, var(--cashmere) 50%, var(--gold) 100%);
    mix-blend-mode: multiply;
    opacity: 0.34;
  }

  .pillar-figure::after{
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(270deg, rgba(231,226,221,0.30) 0%, rgba(231,226,221,0) 19%),
      linear-gradient(to top, rgba(26,22,19,0.34) 0%, rgba(26,22,19,0) 44%);
  }

  .pillar-copy{
    padding: clamp(88px, 12vw, 176px) var(--gutter-wide) clamp(88px, 12vw, 176px) clamp(44px, 5.6vw, 104px);
    max-width: 820px;
  }

  .pillar-kicker{
    margin: 0 0 var(--s3);
    font-family: var(--sans);
    font-weight: 400;
    font-size: 10.5px;
    line-height: 1.8;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--slate);
  }

  .pillar-kicker::before{
    content: "";
    display: block;
    width: 40px;
    height: 1px;
    background: var(--hair-strong);
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .pillar-role{
    margin: 0 0 clamp(32px, 4vw, 52px);
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(12px, 1.1vw, 14px);
    line-height: 1.6;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--obsidian);
  }

  .pillar-lede{
    margin: 0 0 clamp(36px, 4.2vw, 56px);
    font-family: var(--display);
    /* Lede tier — opsz 72, SOFT 35. Between the section-heading and the
       body-adjacent grades: still sharp, but the terminals have begun to
       round as the size comes down toward reading scale. */
    font-variation-settings: var(--fx-lede);
    font-weight: 350;
    font-size: clamp(27px, 3.1vw, 44px);
    line-height: 1.22;
    letter-spacing: -0.018em;
    color: var(--obsidian);
    text-wrap: pretty;
  }

  .pillar-body{
    margin: 0;
    font-family: var(--sans);
    font-weight: 300;
    font-size: 16px;
    line-height: 1.75;
    letter-spacing: 0.004em;
    color: var(--slate);
    text-wrap: pretty;
  }

  .pillar-body p{ margin: 0; }
  .pillar-body p + p{ margin-top: 1.5em; }

  /* Solid fill, high contrast. Never a ghost or outline button.
     Porcelain on Obsidian is 12.9:1. */
  .pillar-link{
    margin-top: clamp(44px, 5.4vw, 72px);
    font-family: var(--sans);
    font-weight: 500;
    font-size: 10.5px;
    line-height: 1.8;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--porcelain);
    background-color: var(--obsidian);
    text-decoration: none;
    padding: 18px 32px;
    border: 0;
    box-shadow:
      0 1px 2px rgba(26, 22, 19, 0.16),
      0 8px 20px -6px rgba(26, 22, 19, 0.26),
      0 18px 42px -14px rgba(71, 68, 64, 0.30);
    transition: background-color 320ms var(--ease), color 320ms var(--ease),
                transform 320ms var(--ease), box-shadow 320ms var(--ease);
  }

  .pillar-link:hover,
  .pillar-link:focus-visible{
    background-color: var(--slate);
    color: var(--porcelain);
    transform: translateY(-2px);
    box-shadow:
      0 1px 2px rgba(26, 22, 19, 0.18),
      0 12px 26px -6px rgba(26, 22, 19, 0.30),
      0 26px 54px -16px rgba(71, 68, 64, 0.34);
  }
  .pillar-link:active{
    transform: translateY(0);
    box-shadow: 0 1px 2px rgba(26, 22, 19, 0.20);
  }
  .pillar-link:focus-visible{ outline: 2px solid var(--gold); outline-offset: 5px; }

  @media (max-width: 900px){
    .pillar{
      grid-template-columns: 1fr;
    }
    .pillar-figure{
      min-height: 0;
      aspect-ratio: 4 / 5;
      margin-right: var(--gutter);  /* bleeds off the left edge */
    }
    .pillar-figure::after{
      background:
        linear-gradient(90deg, rgba(231,226,221,0) 62%, rgba(231,226,221,0.36) 100%),
        linear-gradient(to top, rgba(26,22,19,0.30) 0%, rgba(26,22,19,0) 44%);
    }
    .pillar-copy{
      padding: clamp(72px, 14vw, 104px) var(--gutter);
      max-width: none;
    }
  }
</style>
