---
// 4. PILLAR — Premier Leadership, LLC.
// The photograph drops to the `column` tier (3-8, the body measure) and the
// lede is promoted to a true pull quote: it breaks OUT of the measure it
// interrupts, sharing neither edge with the paragraphs around it.
import { Image } from 'astro:assets';
import portraitSeated from '../assets/portrait-seated.jpg';
---

<section class="pillar spread" id="sec-pillar">
  <div class="pillar-head col-body">
    <p class="pillar-kicker">Premier Leadership, LLC</p>
    <p class="pillar-role">Founder &amp; CEO | Educational Consultant</p>
  </div>

  <figure class="pillar-figure col-body plate-img">
    <Image
      src={portraitSeated}
      alt="Dr. Syreeta McClain seated in a leopard-print blazer against a warm tan ground"
      widths={[480, 720, 960, 1400]}
      sizes="(max-width: 1024px) 100vw, 48vw"
      quality={78}
      loading="eager"
      decoding="sync"
    />
  </figure>

  <!-- Columns 2-10. Starts one column left of the body and ends two columns
       right of it, so neither edge lines up with the paragraphs below. -->
  <p class="pillar-lede col-break">&ldquo;Leadership is not simply a position&mdash;it is the responsibility to move people, ideas, and organizations forward.&rdquo;</p>

  <div class="pillar-copy col-body">
    <div class="pillar-body">
      <p>Premier Leadership was created from more than 20 years of real-world experience leading schools, developing programs, navigating complex systems, and working alongside students, families, educators, and community partners. Dr.&nbsp;McClain brings that experience beyond the schoolhouse to help others turn vision into meaningful action.</p>
      <p>Through consulting, leadership coaching, professional development, workshops, strategic planning, program development, and speaking engagements, Premier Leadership partners with schools, organizations, leaders, and communities ready to strengthen their people and increase their impact.</p>
    </div>
    <a class="pillar-link" href="https://www.premierleadersllc.com" target="_blank" rel="noopener">Visit Premier Leadership</a>
  </div>
</section>

<style>
  /* Standard rhythm above; the elements inside sit TIGHT to one another so
     the section reads as one cluster rather than four stacked blocks. */
  .pillar{ padding-top: var(--vr-standard); }

  .pillar-head{ margin-bottom: var(--s5); }

  .pillar-figure{
    /* Moderate portrait — distinct from the taller field plate and from the
       wide bleed, so the page carries four different proportions, not one. */
    aspect-ratio: 4 / 5;
    margin-bottom: var(--vr-tight);
  }

  .pillar-figure :global(img){
    object-position: 56% 22%;   /* focal point: her face */
    /* Restored from the previous build. The frame is already warm tan, so it
       needs the lightest grade of the four. */
    filter: grayscale(0.14) contrast(1.03);
  }

  .pillar-kicker{
    margin: 0 0 var(--s3);
    font-family: var(--sans);
    font-weight: 400;
    font-size: 10.5px;
    line-height: 1.8;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--slate);
  }

  .pillar-kicker::before{
    content: "";
    display: block;
    width: 40px;
    height: 1px;
    background: var(--hair-strong);
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .pillar-role{
    margin: 0;
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(12px, 1.1vw, 14px);
    line-height: 1.6;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--obsidian);
  }

  /* The pull quote. Larger than it was, because it now has a wider measure to
     fill and has to justify breaking the column to sit there. */
  .pillar-lede{
    margin: 0 0 var(--vr-tight);
    font-family: var(--display);
    /* Lede tier — unchanged. */
    font-variation-settings: var(--fx-lede);
    font-weight: 350;
    font-size: clamp(27px, 3.6vw, 52px);
    line-height: 1.18;
    letter-spacing: -0.018em;
    color: var(--obsidian);
    text-wrap: pretty;
  }

  .pillar-body{
    margin: 0;
    /* Held short of the full 3-8 span: the column frames the text, the text
       does not have to fill it. 62ch keeps the line count readable. */
    max-width: 62ch;
    font-family: var(--sans);
    font-weight: 300;
    font-size: 16px;
    line-height: 1.75;
    letter-spacing: 0.004em;
    color: var(--slate);
    text-wrap: pretty;
  }

  .pillar-body p{ margin: 0; }
  .pillar-body p + p{ margin-top: 1.5em; }

  /* Solid fill, high contrast. Never a ghost or outline button.
     Porcelain on Obsidian is 12.9:1. */
  .pillar-link{
    display: inline-block;
    margin-top: clamp(44px, 5.4vw, 72px);
    font-family: var(--sans);
    font-weight: 500;
    font-size: 10.5px;
    line-height: 1.8;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--porcelain);
    background-color: var(--obsidian);
    text-decoration: none;
    padding: 18px 32px;
    border: 0;
    box-shadow:
      0 1px 2px rgba(26, 22, 19, 0.16),
      0 8px 20px -6px rgba(26, 22, 19, 0.26),
      0 18px 42px -14px rgba(71, 68, 64, 0.30);
    transition: background-color 320ms var(--ease), color 320ms var(--ease),
                transform 320ms var(--ease), box-shadow 320ms var(--ease);
  }

  .pillar-link:hover,
  .pillar-link:focus-visible{
    background-color: var(--slate);
    color: var(--porcelain);
    transform: translateY(-2px);
    box-shadow:
      0 1px 2px rgba(26, 22, 19, 0.18),
      0 12px 26px -6px rgba(26, 22, 19, 0.30),
      0 26px 54px -16px rgba(71, 68, 64, 0.34);
  }
  .pillar-link:active{
    transform: translateY(0);
    box-shadow: 0 1px 2px rgba(26, 22, 19, 0.20);
  }
  .pillar-link:focus-visible{ outline: 2px solid var(--gold); outline-offset: 5px; }

  @media (max-width: 1024px){
    .pillar-figure{ aspect-ratio: 4 / 5; }
    .pillar-body{ max-width: none; }
  }
</style>
