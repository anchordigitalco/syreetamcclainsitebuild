<style>
  /* On the page grid: the footer runs from the body measure's left edge
     (column 3) to the outer trim (column 12), so it shares a left edge with
     the index rows and a right edge with their hung numerals. */
  .site-footer{
    grid-column: 3 / 13;
    padding: clamp(34px, 4vw, 56px) 0 clamp(72px, 9vw, 120px);
    border-top: 1px solid var(--hair-gold);
    gap: var(--s3);
  }

  .footer-copyright{
    margin: 0;
    font-family: var(--sans);
    font-weight: 300;
    font-size: 11px;
    line-height: 1.7;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--slate);
  }

  /* One step down from the client's copyright, 65% opacity, full on hover.
     Inherits the site's own type stack — no separate font import. */
  .footer-credit{
    font-family: var(--sans);
    font-weight: 300;
    font-size: 10px;
    line-height: 1.7;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--slate);
    text-decoration: none;
    opacity: 0.65;
    transition: opacity 320ms var(--ease);
  }

  .footer-credit:hover,
  .footer-credit:focus-visible{ opacity: 1; }
  .footer-credit:focus-visible{ outline: 1px solid var(--gold); outline-offset: 6px; }
  .footer-credit:active{ opacity: 0.8; }

  /* Anchor Digital mark. viewBox 364 171 615 312 is 1.971:1 — height is set and
     width derived from it (14 x 1.9712 = 27.6px). Never equal width and height.
     The root carries fill="currentColor", so it inherits the credit's colour;
     no fill or color override here. */
  .footer-mark{
    display: inline-block;
    width: 27.6px;
    height: 14px;
    margin-right: 0.85em;
    vertical-align: -0.35em;   /* centres the mark on the credit's cap band */
  }

  /* Mobile: stacked and centred, client copyright first. */
  @media (max-width: 1024px){
    .site-footer{
      grid-column: 1 / -1;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--s2);
    }
  }
</style>
