---
// RUNNING HEAD — persistent marker in the live margin (columns 9-12).
// Distinct from the folio marginalia at the left trim: in print a folio and a
// running head are two different things and coexist on the same page. The
// folio marks the page, the running head marks the section.
//
// Positional only. The value swaps instantly on scroll — there is no
// transition between states, by requirement.
---

<div class="runhead" id="runhead" aria-hidden="true" data-active="false">
  <span class="runhead-num" id="runhead-num">02</span>
  <span class="runhead-label" id="runhead-label">About</span>
</div>

<style>
  .runhead{
    position: fixed;
    /* Anchored to the outer trim so it lands in columns 9-12 of the same grid
       the rest of the page is set on. */
    right: calc(var(--grid-left) + var(--grid-pad));
    width: var(--margin-w);
    top: 40px;
    z-index: 40;
    pointer-events: none;
    display: flex;
    align-items: baseline;
    gap: 1.1em;
    justify-content: flex-end;

    font-family: var(--sans);
    font-weight: 400;
    /* The project's smallest type size. */
    font-size: 9.5px;
    line-height: 1.9;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-variant-caps: all-small-caps;
    color: var(--slate);
  }

  /* No transition: the brief forbids animating between values. */
  .runhead[data-active="false"]{ visibility: hidden; }
  .runhead[data-active="true"]{ visibility: visible; }

  .runhead-num{ color: var(--gold); }

  /* Hidden entirely below the grid breakpoint. */
  @media (max-width: 1024px){
    .runhead{ display: none; }
  }
</style>

<script is:inline>
(function () {
  // This component renders BEFORE <main>, so an inline script that resolves
  // the section elements immediately finds none of them and the marker never
  // activates. Initialisation waits for the document to finish parsing.
  function init() {
  var el    = document.getElementById('runhead');
  var num   = document.getElementById('runhead-num');
  var label = document.getElementById('runhead-label');

  var map = [
    { id: 'sec-portrait',            n: '01', t: 'Portrait' },
    { id: 'sec-about',               n: '02', t: 'About' },
    { id: 'sec-education',           n: '03', t: 'Educational Leader' },
    { id: 'sec-pillar',              n: '04', t: 'Premier Leadership' },
    { id: 'sec-legends',             n: '05', t: 'Everyday Legends' },
    { id: 'sec-athletics',           n: '06', t: 'Athletic Management' },
    { id: 'sec-index',               n: '07', t: 'Index' },
    { id: 'charging-it-to-the-game', n: '08', t: 'Charging It to the Game' }
  ];

  var nodes = map
    .map(function (m) { return { el: document.getElementById(m.id), n: m.n, t: m.t }; })
    .filter(function (m) { return m.el; });

  function sync() {
    // A plain scroll-position check against each section's box. No observer,
    // so nothing on the page depends on visibility to render.
    var probe = window.scrollY + (window.innerHeight * 0.4);
    var active = null;
    for (var i = 0; i < nodes.length; i++) {
      var top = nodes[i].el.offsetTop;
      if (probe >= top && probe < top + nodes[i].el.offsetHeight) active = nodes[i];
    }
    if (active) {
      if (num.textContent !== active.n) {
        num.textContent = active.n;
        label.textContent = active.t;
      }
      el.setAttribute('data-active', 'true');
    } else {
      el.setAttribute('data-active', 'false');
    }
  }

  var ticking = false;
  window.addEventListener('scroll', function () {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () { sync(); ticking = false; });
  }, { passive: true });
  window.addEventListener('resize', sync, { passive: true });
  sync();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
