---
// 3. ABOUT — body text in columns 3-8, with the five-line drop cap.
// The cleats/football detail shot now hangs in the live margin (9-11) beside
// this copy rather than occupying a section of its own: it is a detail, and
// details belong in the margin.
import { Image } from 'astro:assets';
import athleticsDetail from '../assets/athletics-detail.jpg';
---

<section class="about spread" id="sec-about">
  <div class="about-body col-body">
    <p><span class="dropcap">D</span>r. Syreeta McClain is an accomplished educational leader, high school principal, consultant, speaker, and nonprofit co-founder with more than two decades of experience transforming the lives of young people and the systems that serve them. She specializes in customized high school programming, alternative education, student engagement, leadership development, and creating innovative pathways for student success. As the CEO of Premier Leadership, LLC, she provides leadership coaching, professional development, workshops, program development, and keynote presentations for educators, schools, organizations, parents, and community leaders.</p>
    <p>She is also the co-founder of the Everyday Legends Foundation, a nonprofit committed to strengthening communities grounded in their three pillars: education, athletics, and service. Drawing from her unique experience as an educator, executive leader, and nonprofit founder, Dr.&nbsp;McClain now bridges her skillsets with the evolving landscape of sports and NIL, as athletic manager to her sons, while empowering individuals and families to maximize their impact.</p>
  </div>

  <figure class="about-inset col-inset plate-img">
    <Image
      src={athleticsDetail}
      alt="A heel resting on a football, goalposts standing behind"
      widths={[320, 480, 640, 900]}
      sizes="(max-width: 1024px) 100vw, 22vw"
      quality={78}
      loading="eager"
      decoding="sync"
    />
  </figure>
</section>

<style>
  .about{ padding-top: var(--vr-standard); }

  .about-body{
    column-count: 2;
    column-gap: clamp(32px, 3.4vw, 52px);
    font-family: var(--sans);
    font-weight: 300;
    font-size: var(--bio-size);
    line-height: var(--bio-lh);
    letter-spacing: 0.004em;
    color: var(--slate);
    text-align: left;
    text-wrap: pretty;      /* rag + widow control */
    orphans: 3;
    widows: 3;
  }

  .about-body p{ margin: 0; }
  .about-body p + p{ margin-top: 1.5em; }

  /* The inset deliberately does NOT start where the paragraph starts.
     Dropping it well down the measure is what stops the margin reading as
     a second column and makes it read as a margin. */
  .about-inset{
    margin-top: clamp(96px, 13vw, 210px);
    aspect-ratio: 3 / 4;
    align-self: start;
  }

  .about-inset :global(img){
    object-position: 50% 62%;   /* focal point: the football */
    /* Restored from the previous build: the turf is the only saturated area
       in this frame and it has to come well down to sit in the palette. */
    filter: grayscale(0.58) contrast(1.06) saturate(0.52);
  }

  /* Warmer than the shared default, to match the heavier desaturation. */
  .about-inset::before{ opacity: 0.44; }

  /* Drop cap — spans exactly 5 lines. Ink cap-height optically aligned to the
     cap height of line 1, ink baseline to the baseline of line 5.

     Untouched by this layout pass: the solve keys off --bio-size and --bio-lh
     and off the drop cap's own axes, none of which changed here.

       required ink cap-height = 4 x line-height + body cap-height
                               = 4(30.6) + 0.70000(17) = 134.30px
       font-size               = 134.30 / 0.69946 = 191.933px */
  /* GOLD */
  .dropcap{
    float: left;
    font-family: var(--display);
    font-variation-settings: var(--fx-dropcap);
    font-weight: 380;
    font-size: 191.933px;
    line-height: 0.64787;              /* box 124.347px; float bottom lands in line 5 */
    color: var(--gold);
    margin: 0.069571em 0.042em 0 0;    /* top 13.353px — drops the ink cap top
                                          onto the line-1 cap top */
    padding: 0;
    -webkit-font-smoothing: antialiased;
  }

  @media (max-width: 1024px){
    .about-body{
      column-count: 1;
      max-width: 62ch;
    }
    /* In one column the inset is no longer a margin element; it becomes a
       full-width plate and needs ordinary section spacing above it. */
    .about-inset{
      margin-top: var(--vr-tight);
      aspect-ratio: 4 / 5;
    }
  }

  @media (max-width: 560px){
    .dropcap{
      /* Re-solved independently for the 16px/1.74 mobile body:
           4(27.84) + 0.70000(16) = 122.56px ink cap-height
           122.56 / 0.69948 = 175.129px */
      font-size: 175.129px;
      line-height: 0.6451;         /* box 112.976px */
      margin-top: 0.07026em;       /* 12.304px */
      margin-right: 0.040em;
    }
  }
</style>
