---
// SIGNATURE MOVE — folio marginalia.
// The only scroll-driven behaviour on the page. It never gates content
// visibility; it only relabels the margin.
---

<div class="folio hidden lg:block fixed left-0 top-1/2 z-40 pointer-events-none" aria-hidden="true">
  <div class="folio-inner" id="folio"><span class="folio-num">01</span><span id="folio-label">Portrait</span></div>
</div>

<style>
  .folio{
    transform: translateY(-50%);
    padding-left: 22px;
  }

  /* vertical-rl + rotate(180deg) reads bottom-to-top exactly like rotate(-90deg)
     but keeps the box narrow and left-anchored, so the folio sits at a fixed
     distance from the trim edge no matter how long the label is.
     Never rotate(-90deg): that makes the bounding box track text width and the
     folio jitters horizontally between labels of different lengths. */
  .folio-inner{
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 9px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--slate);
    opacity: 0;
    transition: opacity 520ms var(--ease);
  }

  .folio-inner.is-visible{ opacity: 0.75; }

  .folio-num{ margin-right: 1.1em; }
</style>

<script is:inline>
(function () {
  // Pre-existing defect: this component renders before <main>, so resolving
  // the section elements inline captured an empty list and the folio never
  // became visible or changed label. Initialisation now waits for parse.
  function init() {
  var folio = document.getElementById('folio');
  var label = document.getElementById('folio-label');
  var num   = folio.querySelector('.folio-num');
  var map = [
    { id: 'sec-portrait',  n: '01', t: 'Portrait' },
    { id: 'sec-about',     n: '02', t: 'About' },
    { id: 'sec-pillar',    n: '03', t: 'Premier Leadership' },
    { id: 'sec-athletics', n: '04', t: 'Athletic Management' },
    { id: 'sec-index',     n: '05', t: 'Index' }
  ];
  var nodes = map.map(function (m) {
    return { el: document.getElementById(m.id), n: m.n, t: m.t };
  }).filter(function (m) { return m.el; });

  function sync() {
    var mid = window.scrollY + window.innerHeight / 2;
    var active = null;
    nodes.forEach(function (m) {
      var top = m.el.offsetTop;
      if (mid >= top && mid < top + m.el.offsetHeight) active = m;
    });
    if (active) {
      if (num.textContent !== active.n) { num.textContent = active.n; label.textContent = active.t; }
      folio.classList.add('is-visible');
    } else {
      folio.classList.remove('is-visible');
    }
  }

  var ticking = false;
  window.addEventListener('scroll', function () {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () { sync(); ticking = false; });
  }, { passive: true });
  window.addEventListener('resize', sync, { passive: true });
  sync();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
