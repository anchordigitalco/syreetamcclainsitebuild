---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Fraunces is requested with all four axes — ital, opsz, wght, SOFT and
       WONK — so no axis is ever left to its default. Every rule that sets
       Fraunces states all four explicitly. -->
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,100..900,0..100,0..1;1,9..144,100..900,0..100,0..1&family=Montserrat:wght@200;300;400;500;600;700&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <slot />

  <!-- Grain sits last and is a SIBLING of the content, never an ancestor —
       an ancestor carrying mix-blend-mode would trap the hero submark's own
       multiply and the white JPEG field would return. -->
  <div class="grain fixed inset-0 z-[60] pointer-events-none" aria-hidden="true"></div>
</body>
</html>
