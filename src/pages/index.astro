---
import BaseLayout from '../layouts/BaseLayout.astro';
import FolioMarginalia from '../components/FolioMarginalia.astro';
import Hero from '../components/Hero.astro';
import PortraitBand from '../components/PortraitBand.astro';
import About from '../components/About.astro';
import PillarEducation from '../components/PillarEducation.astro';
import PillarPremier from '../components/PillarPremier.astro';
import PillarLegends from '../components/PillarLegends.astro';
import PillarAthletics from '../components/PillarAthletics.astro';
import PullQuote from '../components/PullQuote.astro';
import FunnelIndex from '../components/FunnelIndex.astro';
import SectionBlog from '../components/SectionBlog.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Dr. Syreeta McClain — Where Leadership Meets Legacy">
  <!-- The folio at the left trim is the page's ONLY current-section
       indicator. RunningHead used to render a second one in the live margin
       showing the identical string; it was removed rather than restyled. The
       live margin now carries only per-section content — the district link,
       the Instagram handle, the insets — which each section places itself. -->
  <FolioMarginalia />

  <!-- main carries no transform, opacity, filter or isolation, so the hero
       submark's mix-blend-mode composites against the page ground. -->
  <main>
    <Hero />
    <PortraitBand />
    <About />
    <!-- Earliest chronological pillar, so it leads the run. -->
    <PillarEducation />
    <PillarPremier />
    <!-- Sits before the Cashmere band, which is the first thing
         PillarAthletics renders. CONTEXT.md refers to that band as
         BreakBand.astro; there is no such component in this build — the band
         was folded into PillarAthletics during Phase D. -->
    <PillarLegends />
    <PillarAthletics />
    <!-- The quote is this pillar's own closing line; it follows immediately
         and delivers it at full scale, so the pillar's body copy stops short
         of it rather than repeating it. -->
    <PullQuote />
    <FunnelIndex />
    <!-- Carries id="charging-it-to-the-game" so index entry 05 has a real
         anchor available; entry 05 itself is deliberately left at href="#"
         for Jackson to decide. -->
    <SectionBlog />
    <!-- Last content on the page. Follows the blog's coda deliberately: the
         reading order is what she does, then her voice, then how to reach
         her. It opens on its lede rather than on an eyebrow, so it does not
         open the same way the blog above it does. -->
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>
